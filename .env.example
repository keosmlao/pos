# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=pos_db
# PGUSER=pos_app
# PGPASSWORD=replace-with-a-strong-password

# # Use true behind HTTPS. Set false only for a trusted HTTP-only LAN deployment.
# POS_COOKIE_SECURE=true

# # Disabled by default. Enable temporarily only for an authenticated admin setup.
# POS_ALLOW_INIT=false
# POS_BOOTSTRAP_ADMIN_USER=admin
# POS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters

# # Disposable database used only by npm run backup:restore-rehearsal.
# POS_RESTORE_DATABASE=pos_restore_test

# ໂດເມນເພີ່ມທີ່ອະນຸຍາດໃຫ້ສົ່ງຄຳຮ້ອງແກ້ໄຂຂໍ້ມູນ (ກັນ CSRF)
# ປົກກະຕິບໍ່ຕ້ອງຕັ້ງ — ລະບົບອ່ານຈາກ Host / X-Forwarded-Host ເອງ
# ຕັ້ງເມື່ອຜ່ານ CDN ຫຼື ມີຫຼາຍໂດເມນ ເຊັ່ນ: https://pos.example.com,https://pos2.example.com
POS_ALLOWED_ORIGINS=
