<Window x:Class="SmlaoPos.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SMLAO POS — ໜ້າຂາຍ"
        Background="#0f172a"
        MinWidth="900" MinHeight="600"
        Width="1366" Height="800"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.InputBindings>
        <KeyBinding Key="F11" Command="{Binding FullScreenCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ReloadCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding SettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>
    <Grid>
        <wv2:WebView2 x:Name="Web" />
    </Grid>
</Window>
