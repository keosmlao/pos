<Window x:Class="SmlaoPos.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ຕັ້ງຄ່າ SMLAO POS"
        Width="480" Height="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0f172a"
        Loaded="OnLoaded">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94a3b8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e2e8f0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="22">
        <TextBlock Text="⚙️ ຕັ້ງຄ່າ" FontSize="16" Foreground="#f1f5f9" Margin="0,0,0,6" />

        <TextBlock Text="URL ຂອງ Server" />
        <TextBox x:Name="UrlBox" Padding="8" FontSize="13" />

        <CheckBox x:Name="SilentBox" Content="🖨️ ພິມບິນອັດຕະໂນມັດ ບໍ່ຖາມທຸກຄັ້ງ" />

        <TextBlock Text="Printer ສຳລັບພິມບິນ" />
        <ComboBox x:Name="PrinterBox" Padding="6" FontSize="12" />

        <TextBlock Text="COM port ຂອງລີ້ນຊັກເງິນ" />
        <ComboBox x:Name="PortBox" Padding="6" FontSize="12" />

        <TextBlock x:Name="PendingText" Foreground="#fbbf24" Margin="0,16,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="ຍົກເລີກ" Width="100" Height="34" Margin="0,0,8,0" Click="OnCancel" />
            <Button Content="ບັນທຶກ" Width="120" Height="34" Click="OnSave"
                    Background="#dc2626" Foreground="White" FontWeight="Bold" />
        </StackPanel>
    </StackPanel>
</Window>
